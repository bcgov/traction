{
  "name": "tenant-ui-frontend",
  "private": true,
  "version": "1.4.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint \"{src,test,scripts}/**/*.{ts,js,vue}\" \"*.{js,ts}\" --max-warnings=0",
    "lintfix": "eslint \"{src,test,scripts}/**/*.{ts,js,vue}\" \"*.{js,ts}\" --fix",
    "i18n:fill-keys": "node ./scripts/i18n/fillKeys.js",
    "i18n:common-keys": "node ./scripts/i18n/commonKeys.js",
    "i18n:sort-keys": "node ./scripts/i18n/sortKeys.js",
    "test": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.4",
    "@jsonforms/core": "^3.8.0",
    "@jsonforms/vue": "^3.8.0",
    "@jsonforms/vue-vanilla": "^3.8.0",
    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.4",
    "axios": "^1.19.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.13",
    "json-editor-vue": "^0.19.1",
    "marked": "^18.0.9",
    "oidc-client-ts": "^3.5.0",
    "pinia": "^4.0.2",
    "primeflex": "^4.0.0",
    "primeicons": "^8.0.0",
    "primevue": "^3.53.1",
    "qrcode.vue": "^3.10.0",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "vue-json-pretty": "^2.6.0",
    "vue-router": "^5.2.0",
    "vue-toastification": "^2.0.0-rc.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@pinia/testing": "^2.0.1",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.10.0",
    "flat": "^6.0.1",
    "glob": "^13.0.6",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "~8.2.2",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9",
    "whatwg-fetch": "^3.6.20"
  }
}
