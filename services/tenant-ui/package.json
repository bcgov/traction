{
  "name": "tenant-ui",
  "version": "1.4.3",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "description": "The backend for the Tenant UI service, providing API endpoints and serving the static Vue frontend.",
  "main": "index.ts",
  "scripts": {
    "build": "rimraf dist && tsc",
    "prestart": "npm run build",
    "start": "node --enable-source-maps dist/src/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint \"{src,test}/**/*.{ts,js}\" \"*.{js,ts}\" --max-warnings=0",
    "lintfix": "eslint \"{src,test}/**/*.{ts,js}\" \"*.{js,ts}\" --fix",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.20.0",
    "config": "^5.0.1",
    "connect-history-api-fallback": "^2.0.0",
    "cors": "^2.8.6",
    "eta": "^4.6.0",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/connect-history-api-fallback": "^1.5.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.1",
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}